<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Listing photos are loaded over HTTPS (Coil + OkHttp); the bundled WebP pack covers offline use. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Viewing reminders and agent messages (asked at booking time and on the first chat message on
         Android 13+; both features work without it). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Map "My location" only: approximate position from the last known fix, asked when the button is tapped.
         Never fine location, never in the background. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Location is optional: the map hides the button on devices without a provider. -->
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.network"
        android:required="false" />

    <!-- Voice search hands off to the system speech recognizer (no microphone permission); declared so the
         Search screen can tell whether one is installed (package visibility, Android 11+). -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:name=".FindoraApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Findora.Splash"
        tools:targetApi="35">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Shared listing links: findora://property/{propertyId} opens the detail page. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="property"
                    android:scheme="findora" />
            </intent-filter>
            <!-- Message notifications: findora://chat/{conversationId} opens the thread (owner only). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:host="chat"
                    android:scheme="findora" />
            </intent-filter>
            <!-- New-match notifications: findora://search/{searchId} opens Home with that saved search (owner only). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:host="search"
                    android:scheme="findora" />
            </intent-filter>
        </activity>

        <!-- "Findora picks" home-screen widget (Jetpack Glance). -->
        <receiver
            android:name=".widget.FindoraPicksWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_picks_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/findora_picks_widget_info" />
        </receiver>

        <!-- Per-app language below Android 13: AppCompat stores the chosen locale itself and restores it at launch
             (Android 13+ keeps it in the system, where it also appears in the app's language settings). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- WorkManager is initialised on demand by FindoraApplication (Configuration.Provider + HiltWorkerFactory). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
